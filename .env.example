# Copy to .env before the first `docker compose up`.
#
# SQL Server refuses to start unless this is at least 8 characters and mixes
# upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=Epm_Local_Dev_1

# Development (default) keeps /api/dev/reset and /api/dev/load-fixture open,
# which is how the 06 §12 fixture gets into an otherwise empty database.
ASPNETCORE_ENVIRONMENT=Development
